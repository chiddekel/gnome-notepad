#: data/io.github.chiddekel.Notepad.desktop.in:2
#: data/io.github.chiddekel.Notepad.metainfo.xml.in:8
msgid "A simple, native GNOME text editor"
msgstr "Ein einfacher, nativer GNOME-Texteditor"

#: data/io.github.chiddekel.Notepad.metainfo.xml.in:11
msgid ""
"Notepad is a lightweight, native GNOME port of legacy-notepad, a Win32 "
"Notepad clone. It supports multi-encoding text (UTF-8, UTF-8 BOM, UTF-16 "
"LE/BE, ANSI) with configurable line endings, find/replace with wraparound "
"search, printing, an optional background image behind the editor, and "
"light/dark themes that follow your system preference."
msgstr ""
"Notepad ist ein leichtgewichtiger, nativer GNOME-Port von legacy-notepad, "
"einem Klon des Win32-Editors. Es unterstützt Text in mehreren Kodierungen "
"(UTF-8, UTF-8 BOM, UTF-16 LE/BE, ANSI) mit konfigurierbaren Zeilenenden, "
"Suchen/Ersetzen mit umlaufender Suche, Drucken, einem optionalen "
"Hintergrundbild hinter dem Editor sowie hellen/dunklen Designs, die der "
"Systemeinstellung folgen."

#: data/io.github.chiddekel.Notepad.metainfo.xml.in:24
msgid "Notepad's main editing window"
msgstr "Hauptfenster von Notepad"

#: data/io.github.chiddekel.Notepad.metainfo.xml.in:41
msgid "Initial release: a native GNOME port of legacy-notepad."
msgstr "Erstveröffentlichung: ein nativer GNOME-Port von legacy-notepad."
