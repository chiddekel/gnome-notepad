<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <!--
    Mirrors legacy-notepad's src/notepad.rc MENU block 1:1, minus the
    View > Icon submenu (icon-library extraction from .exe/.dll/.icl/.mun
    has no Linux equivalent and was dropped per the plan's locked decision).
    Accelerators are NOT embedded here; GTK shows them automatically next
    to each item once registered via Gtk::Application::set_accels_for_action()
    in application.cpp, matching the table in notepad.rc's ACCELERATORS block.
    Items whose action isn't registered yet render insensitive; they light up
    phase by phase (Phase 6: File/Edit basics, Phase 7: dialogs, Phase 8:
    dark mode, Phase 9: background, Phase 10: language).

    File/Edit/Format/View/Help submenus carry an id= so Window::build_menu()
    (Phase EXTRA A) can also pull them into a second Gtk::PopoverMenuBar, a
    classic Win32-style menu row under the header bar, reusing the same
    Gio::MenuModel objects (and therefore the same actions/state) as the
    hamburger menu. language-menu is deliberately left out of that classic
    bar; Language stays hamburger-menu only.
  -->
  <menu id="menubar">
    <submenu id="file-menu">
      <attribute name="label" translatable="yes">_File</attribute>
      <section>
        <item>
          <attribute name="label" translatable="yes">_New</attribute>
          <attribute name="action">win.new</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">_Open...</attribute>
          <attribute name="action">win.open</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">_Save</attribute>
          <attribute name="action">win.save</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">Save _As...</attribute>
          <attribute name="action">win.save-as</attribute>
        </item>
      </section>
      <section>
        <!--
          Empty at load time; Window::rebuild_recent_files_menu() populates
          it from AppState::recent_files (win.open-recent, one item per
          path), matching legacy-notepad's dynamically-rebuilt Recent Files
          submenu (UpdateRecentFilesMenu()). Hidden via visible-when when
          empty so an empty "Recent Files" entry doesn't linger in the menu.
        -->
        <submenu id="recent-files-menu">
          <attribute name="label" translatable="yes">Recent _Files</attribute>
          <attribute name="hidden-when">action-disabled</attribute>
          <attribute name="action">win.has-recent-files</attribute>
        </submenu>
      </section>
      <section>
        <item>
          <attribute name="label" translatable="yes">_Print...</attribute>
          <attribute name="action">win.print</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">Page Set_up...</attribute>
          <attribute name="action">win.page-setup</attribute>
        </item>
      </section>
      <section>
        <item>
          <attribute name="label" translatable="yes">E_xit</attribute>
          <attribute name="action">app.quit</attribute>
        </item>
      </section>
    </submenu>

    <submenu id="edit-menu">
      <attribute name="label" translatable="yes">_Edit</attribute>
      <section>
        <item>
          <attribute name="label" translatable="yes">_Undo</attribute>
          <attribute name="action">win.undo</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">_Redo</attribute>
          <attribute name="action">win.redo</attribute>
        </item>
      </section>
      <section>
        <item>
          <attribute name="label" translatable="yes">Cu_t</attribute>
          <attribute name="action">win.cut</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">_Copy</attribute>
          <attribute name="action">win.copy</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">_Paste</attribute>
          <attribute name="action">win.paste</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">De_lete</attribute>
          <attribute name="action">win.delete</attribute>
        </item>
      </section>
      <section>
        <item>
          <attribute name="label" translatable="yes">_Find...</attribute>
          <attribute name="action">win.find</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">Find _Next</attribute>
          <attribute name="action">win.find-next</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">Find Pre_vious</attribute>
          <attribute name="action">win.find-previous</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">_Replace...</attribute>
          <attribute name="action">win.replace</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">_Go To...</attribute>
          <attribute name="action">win.goto</attribute>
        </item>
      </section>
      <section>
        <item>
          <attribute name="label" translatable="yes">Select _All</attribute>
          <attribute name="action">win.select-all</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">Time/_Date</attribute>
          <attribute name="action">win.time-date</attribute>
        </item>
      </section>
    </submenu>

    <submenu id="format-menu">
      <attribute name="label" translatable="yes">F_ormat</attribute>
      <section>
        <item>
          <attribute name="label" translatable="yes">_Word Wrap</attribute>
          <attribute name="action">win.word-wrap</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">_Font...</attribute>
          <attribute name="action">win.font</attribute>
        </item>
      </section>
    </submenu>

    <submenu id="view-menu">
      <attribute name="label" translatable="yes">_View</attribute>
      <section>
        <item>
          <attribute name="label" translatable="yes">Zoom _In</attribute>
          <attribute name="action">win.zoom-in</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">Zoom _Out</attribute>
          <attribute name="action">win.zoom-out</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">_Restore Default Zoom</attribute>
          <attribute name="action">win.zoom-default</attribute>
        </item>
      </section>
      <section>
        <item>
          <attribute name="label" translatable="yes">_Status Bar</attribute>
          <attribute name="action">win.status-bar</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">_Dark Mode</attribute>
          <attribute name="action">win.dark-mode</attribute>
        </item>
      </section>
      <section>
        <submenu>
          <attribute name="label" translatable="yes">_Background</attribute>
          <section>
            <item>
              <attribute name="label" translatable="yes">_Select Image...</attribute>
              <attribute name="action">win.background-select</attribute>
            </item>
            <item>
              <attribute name="label" translatable="yes">_Clear Background</attribute>
              <attribute name="action">win.background-clear</attribute>
            </item>
            <item>
              <attribute name="label" translatable="yes">_Opacity...</attribute>
              <attribute name="action">win.background-opacity</attribute>
            </item>
          </section>
          <submenu>
            <attribute name="label" translatable="yes">_Position</attribute>
            <section>
              <item>
                <attribute name="label" translatable="yes">Top Left</attribute>
                <attribute name="action">win.background-position</attribute>
                <attribute name="target">top-left</attribute>
              </item>
              <item>
                <attribute name="label" translatable="yes">Top Center</attribute>
                <attribute name="action">win.background-position</attribute>
                <attribute name="target">top-center</attribute>
              </item>
              <item>
                <attribute name="label" translatable="yes">Top Right</attribute>
                <attribute name="action">win.background-position</attribute>
                <attribute name="target">top-right</attribute>
              </item>
            </section>
            <section>
              <item>
                <attribute name="label" translatable="yes">Center Left</attribute>
                <attribute name="action">win.background-position</attribute>
                <attribute name="target">center-left</attribute>
              </item>
              <item>
                <attribute name="label" translatable="yes">Center</attribute>
                <attribute name="action">win.background-position</attribute>
                <attribute name="target">center</attribute>
              </item>
              <item>
                <attribute name="label" translatable="yes">Center Right</attribute>
                <attribute name="action">win.background-position</attribute>
                <attribute name="target">center-right</attribute>
              </item>
            </section>
            <section>
              <item>
                <attribute name="label" translatable="yes">Bottom Left</attribute>
                <attribute name="action">win.background-position</attribute>
                <attribute name="target">bottom-left</attribute>
              </item>
              <item>
                <attribute name="label" translatable="yes">Bottom Center</attribute>
                <attribute name="action">win.background-position</attribute>
                <attribute name="target">bottom-center</attribute>
              </item>
              <item>
                <attribute name="label" translatable="yes">Bottom Right</attribute>
                <attribute name="action">win.background-position</attribute>
                <attribute name="target">bottom-right</attribute>
              </item>
            </section>
            <section>
              <item>
                <attribute name="label" translatable="yes">Tile</attribute>
                <attribute name="action">win.background-position</attribute>
                <attribute name="target">tile</attribute>
              </item>
              <item>
                <attribute name="label" translatable="yes">Stretch</attribute>
                <attribute name="action">win.background-position</attribute>
                <attribute name="target">stretch</attribute>
              </item>
              <item>
                <attribute name="label" translatable="yes">Fit</attribute>
                <attribute name="action">win.background-position</attribute>
                <attribute name="target">fit</attribute>
              </item>
              <item>
                <attribute name="label" translatable="yes">Fill</attribute>
                <attribute name="action">win.background-position</attribute>
                <attribute name="target">fill</attribute>
              </item>
            </section>
          </submenu>
        </submenu>
      </section>
      <section>
        <item>
          <attribute name="label" translatable="yes">Window _Transparency...</attribute>
          <attribute name="action">win.transparency</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">Always on _Top</attribute>
          <attribute name="action">win.always-on-top</attribute>
        </item>
      </section>
    </submenu>

    <submenu id="language-menu">
      <attribute name="label" translatable="yes">_Language</attribute>
      <section>
        <item>
          <attribute name="label" translatable="yes">_English</attribute>
          <attribute name="action">win.language</attribute>
          <attribute name="target">en</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">_Spanish</attribute>
          <attribute name="action">win.language</attribute>
          <attribute name="target">es</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">Por_tuguese</attribute>
          <attribute name="action">win.language</attribute>
          <attribute name="target">pt</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">_French</attribute>
          <attribute name="action">win.language</attribute>
          <attribute name="target">fr</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">_German</attribute>
          <attribute name="action">win.language</attribute>
          <attribute name="target">de</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">_Japanese</attribute>
          <attribute name="action">win.language</attribute>
          <attribute name="target">ja</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">_Korean</attribute>
          <attribute name="action">win.language</attribute>
          <attribute name="target">ko</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">_Arabic</attribute>
          <attribute name="action">win.language</attribute>
          <attribute name="target">ar</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">_Hindi</attribute>
          <attribute name="action">win.language</attribute>
          <attribute name="target">hi</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">_Chinese</attribute>
          <attribute name="action">win.language</attribute>
          <attribute name="target">zh</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">_Polish</attribute>
          <attribute name="action">win.language</attribute>
          <attribute name="target">pl</attribute>
        </item>
      </section>
    </submenu>

    <submenu id="help-menu">
      <attribute name="label" translatable="yes">_Help</attribute>
      <section>
        <item>
          <attribute name="label" translatable="yes">Check for _Updates...</attribute>
          <attribute name="action">win.check-updates</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">_About Notepad</attribute>
          <attribute name="action">win.about</attribute>
        </item>
      </section>
    </submenu>
  </menu>
</interface>
